# Connectly Environment Configuration
# Copy this file to .env and replace placeholder values before deployment.

# Application URL (used for CORS origin checks and documentation)
APP_URL="http://localhost:3000"

# Dedicated Python TCP Messaging Server Configuration
TCP_HOST="127.0.0.1"
TCP_PORT="9000"

# Database Configuration (SQLite path or PostgreSQL URL for Docker/Cloud)
DB_PATH="./database/connectly.db"
DATABASE_URL="sqlite:///./database/connectly.db"

# Session & Token Signing Secret (leave empty in dev for auto-generated runtime secret)
SESSION_SECRET="2DXMsILhWwF1PLdBHT_RGp4KMWKt3OrPqFeWamarN3t7zb5DjsRrSyg1LEcs_XQh"
APP_URL="http://localhost:3000"

# Python Gateway Port (used when running FastAPI gateway directly or via Docker)
GATEWAY_PORT="8000"
PORT="3000"
